# GlobeTrek Server Environment Configuration Example

PORT=8081
APP_PORT=8081
HOST_NAME=localhost
NODE_ENV=production
# false khi mở web bằng http://IP:8081. Đặt true sau khi đã có HTTPS.
COOKIE_SECURE=false

# Database Configuration
# Hai dòng Mongo dùng khi chạy Node trực tiếp trên máy, trỏ vào container cổng 27018.
# docker compose tự trỏ ứng dụng vào MongoDB trong mạng Docker và bật xác thực.
MONGO_ROOT_USERNAME=globetrek
MONGO_ROOT_PASSWORD=your_mongo_root_password
MONGODB_URI=mongodb://globetrek:your_mongo_root_password@127.0.0.1:27018/GlobeTrek?authSource=admin
REDIS_URL=redis://127.0.0.1:6379
ORDER_HOLD_MINUTES=15

# Authentication Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
Admin_Key=your_admin_key
User_Key=your_user_key

# MinIO Object Storage (Self-hosted S3)
USE_CLOUDINARY=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=globetrek-media
# Trên VPS đổi thành địa chỉ công khai, ví dụ http://203.0.113.10:9000
MINIO_PUBLIC_URL=http://localhost:9000

# Cloudinary (Fallback if USE_CLOUDINARY=true)
CLOUD_NAME=your_cloudinary_cloud_name
API_CLOUD_KEY=your_cloudinary_api_key
API_CLOUD_SECRET=your_cloudinary_api_secret

# Email / Nodemailer Configuration
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Client & URLs
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
VITE_REDIRECT_URL=https://globetrek-six.vercel.app
CORS_ORIGINS=https://globetrek-six.vercel.app
WEBHOOK_SECRET=your_webhook_secret
POINTER_SSO_URL=https://sso-pointer.vercel.app/authorize
