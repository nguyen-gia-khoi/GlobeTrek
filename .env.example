# GlobeTrek Server Environment Configuration Example

PORT=8081
HOST_NAME=localhost
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/GlobeTrek
REDIS_URL=redis://127.0.0.1:6379
ORDER_HOLD_MINUTES=15

# Authentication Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
Admin_Key=your_admin_key
User_Key=your_user_key

# MinIO Object Storage (Self-hosted S3)
USE_CLOUDINARY=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin_globetrek
MINIO_SECRET_KEY=MatKhauSieuBaoMat123@
MINIO_BUCKET_NAME=globetrek-media
MINIO_PUBLIC_URL=http://localhost:9000

# Cloudinary (Fallback if USE_CLOUDINARY=true)
CLOUD_NAME=your_cloudinary_cloud_name
API_CLOUD_KEY=your_cloudinary_api_key
API_CLOUD_SECRET=your_cloudinary_api_secret

# Email / Nodemailer Configuration
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Client & URLs
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
VITE_REDIRECT_URL=https://globetrek-six.vercel.app
CORS_ORIGINS=https://globetrek-six.vercel.app
WEBHOOK_SECRET=replace_with_a_long_random_secret
POINTER_SSO_URL=https://sso-pointer.vercel.app/authorize
