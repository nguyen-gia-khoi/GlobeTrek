<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đối Tác Đã Xác Thực - GlobeTrek Admin</title>
    
    <!-- Favicon / Brand Logo -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="shortcut icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="apple-touch-icon" href="/images/logo.jpg">
</head>
<body>
    <%- include('../header', { pageTitle: 'viewPartner' }) %>

    <div class="main-content-layout">
        <!-- Header -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <h2 class="fw-bold text-main mb-1">Danh Sách Đối Tác Đã Xác Minh</h2>
                <p class="text-muted fs-sm mb-0">Quản lý các công ty và cá nhân cung cấp dịch vụ tour đã được cấp phép</p>
            </div>
            <div>
                <span class="badge-gt badge-gt-success">
                    <i class="fas fa-handshake"></i> <%= verifiedPartners ? verifiedPartners.length : 0 %> Đối tác đã duyệt
                </span>
            </div>
        </div>

        <!-- Partners Table -->
        <div class="table-gt-container">
            <div class="table-responsive">
                <table class="table-gt">
                    <thead>
                        <tr>
                            <th>Tên Doanh Nghiệp / Đối Tác</th>
                            <th>Email Liên Hệ</th>
                            <th>Trạng Thái</th>
                            <th class="text-end">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!verifiedPartners || verifiedPartners.length === 0) { %>
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">Chưa có đối tác nào được xác minh.</td>
                            </tr>
                        <% } else { %>
                            <% verifiedPartners.forEach(partner => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-xs" style="width: 38px; height: 38px; background: var(--gradient-accent);">
                                                <%= partner.name ? partner.name.charAt(0).toUpperCase() : 'P' %>
                                            </div>
                                            <div class="fw-bold text-main fs-sm"><%= partner.name %></div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fs-sm text-muted"><%= partner.email %></span>
                                    </td>
                                    <td>
                                        <span class="badge-gt badge-gt-success">
                                            <i class="fas fa-shield-check"></i> Đã xác thực
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <button type="button" 
                                                    class="btn btn-gt-ghost text-primary btn-gt-sm btn-partner-detail" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#detailPartnerModal"
                                                    data-id="<%= partner._id %>"
                                                    data-name="<%= partner.name %>"
                                                    data-email="<%= partner.email %>"
                                                    data-phone="<%= partner.phone || partner.phoneNumber || 'Chưa cập nhật' %>"
                                                    data-gender="<%= partner.gender || 'Chưa cập nhật' %>"
                                                    data-dob="<%= partner.dob ? new Date(partner.dob).toLocaleDateString('vi-VN') : (partner.dateOfBirth ? new Date(partner.dateOfBirth).toLocaleDateString('vi-VN') : 'Chưa cập nhật') %>"
                                                    data-address="<%= partner.address || 'Chưa cập nhật' %>"
                                                    data-created="<%= partner.createdAt ? new Date(partner.createdAt).toLocaleString('vi-VN') : 'Đối tác lâu năm' %>"
                                                    title="Xem chi tiết đối tác">
                                                <i class="fas fa-eye me-1"></i> Chi tiết
                                            </button>
                                            <form action="/admin/banPartner" method="POST" class="d-inline m-0">
                                                <input type="hidden" name="partnerId" value="<%= partner._id %>">
                                                <input type="hidden" name="action" value="ban">
                                                <button type="submit" onclick="return confirm('Bạn có chắc chắn muốn hủy quyền đối tác này?');" class="btn btn-gt-ghost text-danger btn-gt-sm border">
                                                    <i class="fas fa-ban me-1"></i> Hủy Quyền
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal: Xem Chi Tiết Đối Tác -->
    <div class="modal fade" id="detailPartnerModal" tabindex="-1" aria-labelledby="detailPartnerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content modal-gt-content">
                <div class="modal-header border-0 bg-subtle-mint">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-badge cyan" id="detailPartnerAvatar" style="font-weight: 700; font-size: 1.15rem;">
                            P
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-main mb-0" id="detailPartnerName">Hồ Sơ Đối Tác</h5>
                            <span class="badge-gt badge-gt-success fs-xs mt-1">
                                <i class="fas fa-shield-check me-1"></i> Đã xác minh
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 bg-body">
                    <div class="detail-section-card mb-0">
                        <div class="detail-section-title">
                            <i class="fas fa-building text-primary"></i> Thông Tin Doanh Nghiệp / Đối Tác
                        </div>
                        <div class="detail-field-row">
                            <span class="detail-field-label">Email Liên Hệ:</span>
                            <span class="detail-field-value fw-semibold text-primary" id="detailPartnerEmail">—</span>
                        </div>
                        <div class="detail-field-row">
                            <span class="detail-field-label">Số Điện Thoại:</span>
                            <span class="detail-field-value" id="detailPartnerPhone">—</span>
                        </div>
                        <div class="detail-field-row">
                            <span class="detail-field-label">Giới Tính:</span>
                            <span class="detail-field-value" id="detailPartnerGender">—</span>
                        </div>
                        <div class="detail-field-row">
                            <span class="detail-field-label">Ngày Sinh (DOB):</span>
                            <span class="detail-field-value fw-semibold" id="detailPartnerDob">—</span>
                        </div>
                        <div class="detail-field-row">
                            <span class="detail-field-label">Địa Chỉ Trụ Sở:</span>
                            <span class="detail-field-value" id="detailPartnerAddress">—</span>
                        </div>
                        <div class="detail-field-row">
                            <span class="detail-field-label">Ngày Xác Thực:</span>
                            <span class="detail-field-value text-muted fs-xs" id="detailPartnerCreated">—</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-white">
                    <button type="button" class="btn btn-gt-ghost" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const detailPartnerModal = document.getElementById('detailPartnerModal');
        if (detailPartnerModal) {
            detailPartnerModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                if (!button) return;
                const id = button.getAttribute('data-id') || '';
                const name = button.getAttribute('data-name') || 'Đối Tác';
                const email = button.getAttribute('data-email') || '—';
                const phone = button.getAttribute('data-phone') || 'Chưa cập nhật';
                const gender = button.getAttribute('data-gender') || 'Chưa cập nhật';
                const dob = button.getAttribute('data-dob') || 'Chưa cập nhật';
                const address = button.getAttribute('data-address') || 'Chưa cập nhật';
                const created = button.getAttribute('data-created') || '—';

                const nameEl = document.getElementById('detailPartnerName');
                if (nameEl) nameEl.textContent = name;

                const avatarEl = document.getElementById('detailPartnerAvatar');
                if (avatarEl) avatarEl.textContent = name ? name.charAt(0).toUpperCase() : 'P';

                const emailEl = document.getElementById('detailPartnerEmail');
                if (emailEl) emailEl.textContent = email;

                const phoneEl = document.getElementById('detailPartnerPhone');
                if (phoneEl) phoneEl.textContent = phone;

                const genderEl = document.getElementById('detailPartnerGender');
                if (genderEl) genderEl.textContent = gender;

                const dobEl = document.getElementById('detailPartnerDob');
                if (dobEl) dobEl.textContent = dob;

                const addressEl = document.getElementById('detailPartnerAddress');
                if (addressEl) addressEl.textContent = address;

                const createdEl = document.getElementById('detailPartnerCreated');
                if (createdEl) createdEl.textContent = created;
            });
        }
    </script>
</body>
</html>
