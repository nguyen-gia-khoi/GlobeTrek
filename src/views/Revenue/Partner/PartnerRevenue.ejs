<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Báo Cáo Doanh Thu Đối Tác - GlobeTrek</title>
    
    <!-- Favicon / Brand Logo -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="shortcut icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="apple-touch-icon" href="/images/logo.jpg">
    
    <!-- Chart.js & SheetJS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.19.3/package/dist/xlsx.full.min.js"></script>
</head>
<body>
    <%- include('../../DashboardPN', { pageTitle: 'Doanh Thu' }) %>

    <div class="main-content-layout">
        <!-- Page Header -->
        <div class="hero-header-gt d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <span class="hero-badge-pill">
                    <i class="fas fa-coins text-warning me-1"></i> Báo Cáo Tài Chính
                </span>
                <h1 class="text-white mb-2">Báo Cáo Doanh Thu Tour</h1>
                <p class="mb-0">Theo dõi doanh số bán vé, lượng khách đặt và tỷ lệ tăng trưởng theo từng hành trình.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm" onclick="exportToExcel()">
                    <i class="fas fa-file-excel text-success me-1"></i> Xuất Báo Cáo Excel
                </button>
            </div>
        </div>

        <!-- KPI Revenue Summary -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="kpi-card">
                    <div class="kpi-icon-wrap kpi-icon-primary">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <div>
                        <div class="kpi-title">Tổng Doanh Thu Đến Nay</div>
                        <div class="kpi-value text-primary font-display">
                            <%= (typeof totalRevenue !== 'undefined' && totalRevenue ? totalRevenue : 0).toLocaleString('vi-VN') %> VNĐ
                        </div>
                        <div class="kpi-trend positive">
                            <i class="fas fa-clock"></i> Tính đến ngày <%= new Date().toLocaleDateString('vi-VN') %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="kpi-card">
                    <div class="kpi-icon-wrap kpi-icon-cyan">
                        <i class="fas fa-chart-pie"></i>
                    </div>
                    <div>
                        <div class="kpi-title">Tổng Số Tour Giao Dịch</div>
                        <div class="kpi-value">
                            <%= (typeof revenueData !== 'undefined' && revenueData ? revenueData.length : 0) %> Tour
                        </div>
                        <div class="kpi-trend positive">
                            <i class="fas fa-circle-check"></i> Đang hoạt động
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts & Table -->
        <div class="row g-4">
            <!-- Table of Tours Revenue -->
            <div class="col-lg-7">
                <div class="card-gt p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h4 class="fw-bold text-main mb-0 fs-5">Doanh Thu Theo Từng Tour</h4>
                        <span class="badge-gt badge-gt-info">
                            <%= typeof partnerName !== 'undefined' && partnerName ? partnerName : 'Đối tác' %>
                        </span>
                    </div>

                    <div class="table-gt-container border-0 shadow-none">
                        <div class="table-responsive">
                            <table class="table-gt" id="revenueTable">
                                <thead>
                                    <tr>
                                        <th>Tên Tour</th>
                                        <th class="text-center">Số Đơn</th>
                                        <th class="text-end">Doanh Thu (VNĐ)</th>
                                    </tr>
                                </thead>
                                <tbody id="revenueTableBody">
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">Đang tải dữ liệu doanh thu...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div id="revenuePagination" class="d-none flex-wrap align-items-center justify-content-between gap-2 mt-3">
                        <span class="text-muted fs-xs" id="revenuePageInfo"></span>
                        <div class="d-flex flex-wrap gap-2" id="revenuePageButtons"></div>
                    </div>
                </div>
            </div>

            <!-- Distribution Chart -->
            <div class="col-lg-5">
                <div class="card-gt p-4 h-100 d-flex flex-column">
                    <h4 class="fw-bold text-main mb-3 fs-5">Tỷ Trọng Doanh Thu</h4>
                    <div class="d-flex align-items-center justify-content-center flex-grow-1" style="min-height: 280px;">
                        <p id="revenueChartEmpty" class="text-muted text-center mb-0 d-none">Chưa có tour nào phát sinh doanh thu.</p>
                        <canvas id="partnerRevenuePieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const revenueData = <%- (typeof revenueData !== 'undefined' && revenueData) ? JSON.stringify(revenueData) : '[]' %>;
        const REVENUE_PAGE_SIZE = 5;
        let revenuePage = 1;

        revenueData.sort((a, b) => (Number(b.revenue) || 0) - (Number(a.revenue) || 0));

        function renderRevenueTable() {
            const tbody = document.getElementById('revenueTableBody');
            const pagination = document.getElementById('revenuePagination');
            const pageInfo = document.getElementById('revenuePageInfo');
            const pageButtons = document.getElementById('revenuePageButtons');
            const total = revenueData.length;

            if (!total) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-muted">Chưa có dữ liệu doanh thu cho các tour.</td></tr>';
                pagination.classList.add('d-none');
                pagination.classList.remove('d-flex');
                return;
            }

            const totalPages = Math.ceil(total / REVENUE_PAGE_SIZE);
            if (revenuePage > totalPages) revenuePage = totalPages;
            if (revenuePage < 1) revenuePage = 1;

            const start = (revenuePage - 1) * REVENUE_PAGE_SIZE;
            const pageItems = revenueData.slice(start, start + REVENUE_PAGE_SIZE);

            tbody.innerHTML = pageItems.map((data) => `
                <tr>
                    <td><div class="fw-bold text-main fs-sm">${escapeHtml(data.tourName || '')}</div></td>
                    <td class="text-center"><span class="badge-gt badge-gt-neutral">${Number(data.ordersCount) || 0} đơn</span></td>
                    <td class="text-end"><strong class="text-primary font-display">${(Number(data.revenue) || 0).toLocaleString('vi-VN')} VNĐ</strong></td>
                </tr>
            `).join('');

            const from = start + 1;
            const to = start + pageItems.length;
            pageInfo.textContent = `${from}–${to} của ${total} tour`;
            pagination.classList.remove('d-none');
            pagination.classList.add('d-flex');

            const buttons = [];
            buttons.push(`<button type="button" class="btn btn-gt-outline btn-gt-sm" data-page="${revenuePage - 1}" ${revenuePage === 1 ? 'disabled' : ''}>Trước</button>`);
            for (let page = 1; page <= totalPages; page += 1) {
                const active = page === revenuePage ? 'btn-gt-primary' : 'btn-gt-outline';
                buttons.push(`<button type="button" class="btn ${active} btn-gt-sm" data-page="${page}">${page}</button>`);
            }
            buttons.push(`<button type="button" class="btn btn-gt-outline btn-gt-sm" data-page="${revenuePage + 1}" ${revenuePage === totalPages ? 'disabled' : ''}>Sau</button>`);
            pageButtons.innerHTML = buttons.join('');
        }

        function renderRevenueChart() {
            const canvas = document.getElementById('partnerRevenuePieChart');
            const empty = document.getElementById('revenueChartEmpty');
            const withRevenue = revenueData.filter((item) => Number(item.revenue) > 0);

            if (!withRevenue.length) {
                canvas.classList.add('d-none');
                empty.classList.remove('d-none');
                return;
            }

            canvas.classList.remove('d-none');
            empty.classList.add('d-none');

            const palette = ['#10b981', '#06b6d4', '#3b82f6', '#f59e0b', '#8b5cf6', '#ec4899', '#14b8a6'];
            new Chart(canvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: withRevenue.map((item) => item.tourName),
                    datasets: [{
                        data: withRevenue.map((item) => Number(item.revenue) || 0),
                        backgroundColor: withRevenue.map((_, index) => palette[index % palette.length]),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${ctx.label}: ${Number(ctx.raw || 0).toLocaleString('vi-VN')} VNĐ`
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        }

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        document.addEventListener('DOMContentLoaded', function () {
            renderRevenueTable();
            renderRevenueChart();

            document.getElementById('revenuePageButtons').addEventListener('click', function (event) {
                const button = event.target.closest('button[data-page]');
                if (!button || button.disabled) return;
                revenuePage = Number(button.dataset.page);
                renderRevenueTable();
            });
        });

        function exportToExcel() {
            const rows = revenueData.map((data) => ({
                'Tên Tour': data.tourName || '',
                'Số Đơn': Number(data.ordersCount) || 0,
                'Doanh Thu (VNĐ)': Number(data.revenue) || 0,
            }));
            const sheet = XLSX.utils.json_to_sheet(rows.length ? rows : [{ 'Tên Tour': '', 'Số Đơn': 0, 'Doanh Thu (VNĐ)': 0 }]);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, sheet, 'DoanhThu');
            XLSX.writeFile(workbook, 'GlobeTrek_DoanhThu_Partner.xlsx');
        }
    </script>
</body>
</html>