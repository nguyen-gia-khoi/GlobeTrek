<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doanh Thu Hàng Năm - GlobeTrek Admin</title>
    
    <!-- Favicon / Brand Logo -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="shortcut icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="apple-touch-icon" href="/images/logo.jpg">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/formatRevenueAxis.js"></script>
</head>
<body>
    <%- include('../header', { pageTitle: 'Doanh thu hàng năm' }) %>

    <div class="main-content-layout">
        <div class="hero-header-gt d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <span class="hero-badge-pill">
                    <i class="fas fa-calendar text-warning me-1"></i> Báo Cáo Theo Năm
                </span>
                <h1 class="text-white mb-2">Doanh Thu Hàng Năm (2 Năm Gần Nhất)</h1>
                <p class="mb-0">So sánh chỉ số tài chính và tăng trưởng dài hạn giữa các năm tài chính.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm" onclick="location.reload()">
                    <i class="fas fa-arrows-rotate me-1"></i> Làm Mới
                </button>
            </div>
        </div>

        <!-- Yearly Chart Card -->
        <div class="card-gt p-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h4 class="fw-bold text-main mb-0">So Sánh Doanh Thu Theo Năm</h4>
                <div class="d-flex gap-2">
                    <span class="badge-gt badge-gt-success"><i class="fas fa-square text-emerald"></i> Doanh thu Admin</span>
                    <span class="badge-gt badge-gt-info"><i class="fas fa-square text-cyan"></i> Doanh thu Partner</span>
                </div>
            </div>

            <div style="height: 380px;">
                <canvas id="yearlyRevenueChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const labels = <%- JSON.stringify(labels || []) %>;
            const adminYearlyRevenue = <%- JSON.stringify(adminRevenues || []) %>;
            const partnerYearlyRevenue = <%- JSON.stringify(partnerRevenues || []) %>;

            const ctx = document.getElementById('yearlyRevenueChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Doanh thu Admin (VNĐ)',
                            data: adminYearlyRevenue,
                            backgroundColor: '#10b981',
                            borderRadius: 10,
                            barPercentage: 0.5
                        },
                        {
                            label: 'Doanh thu Partner (VNĐ)',
                            data: partnerYearlyRevenue,
                            backgroundColor: '#06b6d4',
                            borderRadius: 10,
                            barPercentage: 0.5
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { font: { family: 'Plus Jakarta Sans', size: 12, weight: 'bold' } } },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            padding: 12,
                            cornerRadius: 10,
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: ${Math.round(ctx.raw || 0).toLocaleString('vi-VN')} VNĐ`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(15, 23, 42, 0.06)' },
                            ticks: {
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                maxTicksLimit: 6,
                                callback: (val) => formatRevenueAxis(val)
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 13, weight: 'bold' } }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>
