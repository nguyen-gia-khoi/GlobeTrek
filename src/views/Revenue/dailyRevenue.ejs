<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doanh Thu Hàng Ngày - GlobeTrek Admin</title>
    
    <!-- Favicon / Brand Logo -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="shortcut icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="apple-touch-icon" href="/images/logo.jpg">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/formatRevenueAxis.js"></script>
</head>
<body>
    <%- include('../header', { pageTitle: 'Doanh thu hàng ngày' }) %>

    <div class="main-content-layout">
        <div class="hero-header-gt d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <span class="hero-badge-pill">
                    <i class="fas fa-calendar-day text-warning me-1"></i> Thống Kê Theo Ngày
                </span>
                <h1 class="text-white mb-2">Báo Cáo Doanh Thu Hàng Ngày</h1>
                <p class="mb-0">Thống kê doanh thu 7 ngày trong tuần và phân chia tỷ lệ giữa Hệ Thống (30%) & Đối Tác (70%).</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm" onclick="location.reload()">
                    <i class="fas fa-arrows-rotate me-1"></i> Làm Mới
                </button>
            </div>
        </div>

        <!-- Chart Card -->
        <div class="card-gt p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h4 class="fw-bold text-main mb-1">Biểu Đồ Doanh Thu 7 Ngày Gần Nhất</h4>
                    <p class="text-muted fs-xs mb-0">Phân tách doanh thu sàn GlobeTrek và đối tác cung cấp dịch vụ</p>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge-gt badge-gt-success"><i class="fas fa-square text-emerald"></i> Doanh thu Admin</span>
                    <span class="badge-gt badge-gt-info"><i class="fas fa-square text-cyan"></i> Doanh thu Partner</span>
                </div>
            </div>

            <div style="height: 380px;">
                <canvas id="dailyRevenueChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const revenueData = <%- JSON.stringify(revenueData || []) %>;

            const labels = revenueData.map(data => data.date);
            const adminRevenue = revenueData.map(data => data.admin || 0);
            const partnerRevenue = revenueData.map(data => data.partner || 0);

            const ctx = document.getElementById('dailyRevenueChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Doanh thu Admin (VNĐ)',
                            data: adminRevenue,
                            backgroundColor: '#10b981',
                            borderRadius: 8,
                            barPercentage: 0.6
                        },
                        {
                            label: 'Doanh thu Partner (VNĐ)',
                            data: partnerRevenue,
                            backgroundColor: '#06b6d4',
                            borderRadius: 8,
                            barPercentage: 0.6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { font: { family: 'Plus Jakarta Sans', size: 12, weight: 'bold' } } },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            padding: 12,
                            cornerRadius: 10,
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: ${Math.round(ctx.raw || 0).toLocaleString('vi-VN')} VNĐ`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(15, 23, 42, 0.06)' },
                            ticks: {
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                maxTicksLimit: 6,
                                callback: (val) => formatRevenueAxis(val)
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 12 } }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>
