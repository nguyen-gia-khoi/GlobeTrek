<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tổng Doanh Thu Từng Partner - GlobeTrek Admin</title>
    
    <!-- Favicon / Brand Logo -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="shortcut icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="apple-touch-icon" href="/images/logo.jpg">
</head>
<body>
    <%- include('../header', { pageTitle: 'Tổng doanh thu của từng Partner' }) %>

    <div class="main-content-layout">
        <div class="hero-header-gt d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <span class="hero-badge-pill">
                    <i class="fas fa-coins text-warning me-1"></i> Báo Cáo Tích Lũy
                </span>
                <h1 class="text-white mb-2">Tổng Doanh Thu Của Từng Đối Tác</h1>
                <p class="mb-0">
                    Thống kê doanh số tích lũy cho đến ngày: <strong><%= typeof formattedToday !== 'undefined' ? formattedToday : new Date().toLocaleDateString('vi-VN') %></strong>
                </p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm" onclick="location.reload()">
                    <i class="fas fa-arrows-rotate me-1"></i> Làm Mới
                </button>
            </div>
        </div>

        <!-- Total Revenue Table -->
        <div class="card-gt p-4">
            <div class="table-gt-container border-0 shadow-none">
                <div class="table-responsive">
                    <table class="table-gt">
                        <thead>
                            <tr>
                                <th>Tên Đối Tác</th>
                                <th class="text-end">Tổng Doanh Thu Tích Lũy (VNĐ)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!groupedRevenues || groupedRevenues.length === 0) { %>
                                <tr>
                                    <td colspan="2" class="text-center py-5 text-muted">Chưa có dữ liệu tích lũy cho các đối tác.</td>
                                </tr>
                            <% } else { %>
                                <% groupedRevenues.forEach(function(revenue) { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-xs" style="width: 38px; height: 38px; background: var(--gradient-primary);">
                                                    <%= revenue.partnerName ? revenue.partnerName.charAt(0).toUpperCase() : 'P' %>
                                                </div>
                                                <div class="fw-bold text-main fs-sm"><%= revenue.partnerName %></div>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-primary font-display fs-5">
                                                <%= (revenue.totalSales || 0).toLocaleString('vi-VN') %> VNĐ
                                            </strong>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
