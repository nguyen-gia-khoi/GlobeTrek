<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doanh Thu Hàng Tháng - GlobeTrek Admin</title>
    
    <!-- Favicon / Brand Logo -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="shortcut icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="apple-touch-icon" href="/images/logo.jpg">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/formatRevenueAxis.js"></script>
</head>
<body>
    <%- include('../header', { pageTitle: 'Doanh thu hàng tháng' }) %>

    <div class="main-content-layout">
        <div class="hero-header-gt d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <span class="hero-badge-pill">
                    <i class="fas fa-calendar-alt text-warning me-1"></i> Báo Cáo Theo Tháng
                </span>
                <h1 class="text-white mb-2">Báo Cáo Doanh Thu 6 Tháng Gần Nhất</h1>
                <p class="mb-0">Thống kê tăng trưởng tổng doanh thu và cơ cấu phân bổ giữa GlobeTrek và Đối Tác.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm" onclick="location.reload()">
                    <i class="fas fa-arrows-rotate me-1"></i> Làm Mới
                </button>
            </div>
        </div>

        <!-- Monthly Chart Card -->
        <div class="card-gt p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h4 class="fw-bold text-main mb-1">Xu Hướng Doanh Thu Theo Tháng</h4>
                    <p class="text-muted fs-xs mb-0">Doanh thu tổng cộng cùng phần chia của Admin (30%) và Đối Tác (70%)</p>
                </div>
            </div>

            <div style="height: 400px;">
                <canvas id="monthlyRevenueChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const labels = <%- JSON.stringify(labels || []) %>;
            const monthlyRevenues = <%- JSON.stringify(monthlyRevenues || []) %>;
            const adminRevenues = <%- JSON.stringify(adminRevenues || []) %>;
            const partnerRevenues = <%- JSON.stringify(partnerRevenues || []) %>;

            const ctx = document.getElementById('monthlyRevenueChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels.slice().reverse(),
                    datasets: [
                        {
                            label: 'Tổng Doanh Thu (VNĐ)',
                            data: monthlyRevenues.slice().reverse(),
                            backgroundColor: 'rgba(16, 185, 129, 0.25)',
                            borderColor: '#10b981',
                            borderWidth: 2,
                            borderRadius: 8,
                            order: 2
                        },
                        {
                            label: 'Doanh Thu Admin (30%)',
                            data: adminRevenues.slice().reverse(),
                            backgroundColor: '#06b6d4',
                            borderRadius: 8,
                            order: 1
                        },
                        {
                            label: 'Doanh Thu Partner (70%)',
                            data: partnerRevenues.slice().reverse(),
                            backgroundColor: '#8b5cf6',
                            borderRadius: 8,
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { font: { family: 'Plus Jakarta Sans', size: 12, weight: 'bold' } } },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            padding: 12,
                            cornerRadius: 10,
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: ${Math.round(ctx.raw || 0).toLocaleString('vi-VN')} VNĐ`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(15, 23, 42, 0.06)' },
                            ticks: {
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                maxTicksLimit: 6,
                                callback: (val) => formatRevenueAxis(val)
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 12 } }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>
