<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' - GlobeTrek Partner' : 'GlobeTrek Partner Portal' %></title>
    
    <!-- Favicon / Brand Logo -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="shortcut icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="apple-touch-icon" href="/images/logo.jpg">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts (Plus Jakarta Sans & Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
    <!-- GlobeTrek Design System -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- Top Glass Navbar -->
    <nav class="navbar-gt">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-gt-ghost btn-gt-icon d-lg-none" id="partnerSidebarToggleBtn" aria-label="Toggle Sidebar">
                <i class="fas fa-bars"></i>
            </button>
            
            <a class="brand-logo-wrap" href="/partner/revenue">
                <img src="/images/logo.jpg" alt="Logo GlobeTrek" class="brand-logo-img">
                <div class="d-flex align-items-center">
                    <span class="brand-name">GlobeTrek</span>
                    <span class="brand-badge bg-info text-white">Partner</span>
                </div>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            <a href="/partner/tours/create" class="btn btn-gt-primary btn-gt-sm d-none d-sm-inline-flex">
                <i class="fas fa-plus-circle"></i>
                <span>Tạo Tour Mới</span>
            </a>

            <div class="dropdown">
                <button class="btn btn-gt-ghost d-flex align-items-center gap-2 p-1 pe-3 rounded-pill dropdown-toggle" type="button" id="partnerDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 36px; height: 36px; background: var(--gradient-accent); font-size: 0.9rem;">
                        PN
                    </div>
                    <span class="d-none d-md-inline fw-semibold text-main" style="font-size: 0.9rem;">Đối Tác Tour</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2" aria-labelledby="partnerDropdown" style="min-width: 220px;">
                    <li class="px-3 py-2 border-bottom mb-2">
                        <p class="mb-0 fw-bold text-main" style="font-size: 0.9rem;">Partner Portal</p>
                        <small class="text-muted">partner@globetrek.com</small>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-3 py-2 text-main" href="/partner/revenue">
                            <i class="fas fa-chart-line me-2 text-primary"></i> Doanh thu & Thống kê
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-3 py-2 text-main" href="/partner/tours/list">
                            <i class="fas fa-route me-2 text-secondary"></i> Danh sách Tour
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-3 py-2 text-main" href="/partner/orders">
                            <i class="fas fa-shopping-bag me-2 text-warning"></i> Đơn Đặt Tour
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form action="/api/auth/signout" method="POST" class="m-0">
                            <button type="submit" class="dropdown-item rounded-3 py-2 text-danger fw-semibold">
                                <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Mobile Sidebar Backdrop -->
    <div class="sidebar-backdrop" id="partnerSidebarBackdrop"></div>

    <!-- Partner Sidebar Navigation -->
    <aside class="sidebar-gt" id="partnerSidebar">
        <!-- 1. BẢNG ĐIỀU KHIỂN -->
        <div class="sidebar-heading">Bảng Điều Khiển</div>
        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Trang Chủ') || pageTitle === 'homePartner' || pageTitle === 'Doanh Thu') ? 'active' : '' %>" href="/partner/revenue">
            <i class="fas fa-chart-pie"></i>
            <span>Doanh Thu & Tổng Quan</span>
        </a>

        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Đơn')) ? 'active' : '' %>" href="/partner/orders">
            <i class="fas fa-receipt"></i>
            <span>Đơn Hàng Khách Đặt</span>
        </a>

        <!-- 2. VẬN HÀNH & LỊCH TRÌNH -->
        <div class="sidebar-heading">Vận Hành & Lịch Trình</div>
        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Danh sách Tour')) ? 'active' : '' %>" href="/partner/tours/list">
            <i class="fas fa-list-check"></i>
            <span>Danh Sách Tour Của Tôi</span>
        </a>

        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Tạo Tour')) ? 'active' : '' %>" href="/partner/tours/create">
            <i class="fas fa-plus-circle"></i>
            <span>Thêm Tour Mới</span>
        </a>

        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Lịch Khởi Hành')) ? 'active' : '' %>" href="/partner/departures">
            <i class="fas fa-calendar-alt"></i>
            <span>Lịch Khởi Hành & Chỗ</span>
        </a>

        <!-- 3. TÀI CHÍNH & QUYẾT TOÁN -->
        <div class="sidebar-heading">Tài Chính & Quyết Toán</div>
        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Rút Tiền')) ? 'active' : '' %>" href="javascript:void(0);" onclick="alert('Tính năng Đối Soát & Rút Tiền đang được hoàn thiện!');">
            <i class="fas fa-wallet"></i>
            <span class="d-flex align-items-center justify-content-between flex-grow-1">
                Đối Soát & Rút Tiền
                <span class="badge bg-light text-muted border fs-xs py-0 px-1">Sắp ra mắt</span>
            </span>
        </a>

        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Hiệu Suất')) ? 'active' : '' %>" href="/partner/revenue/tour-performance">
            <i class="fas fa-chart-line"></i>
            <span>Báo Cáo Hiệu Suất Tour</span>
        </a>

        <!-- 4. KHÁCH HÀNG & ĐÁNH GIÁ -->
        <div class="sidebar-heading">Khách Hàng & Đánh Giá</div>
        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Đánh Giá')) ? 'active' : '' %>" href="javascript:void(0);" onclick="alert('Tính năng Đánh Giá Từ Khách đang được hoàn thiện!');">
            <i class="fas fa-star text-warning"></i>
            <span class="d-flex align-items-center justify-content-between flex-grow-1">
                Đánh Giá Từ Khách
                <span class="badge bg-light text-muted border fs-xs py-0 px-1">Sắp ra mắt</span>
            </span>
        </a>

        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Khách Hàng')) ? 'active' : '' %>" href="/partner/orders/history">
            <i class="fas fa-users"></i>
            <span>Lịch Sử Mua Hàng</span>
        </a>

        <!-- 5. MARKETING & KHUYẾN MÃI -->
        <div class="sidebar-heading">Marketing & Khuyến Mãi</div>
        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Khuyến Mãi')) ? 'active' : '' %>" href="/partner/promotions?kind=code">
            <i class="fas fa-tags"></i>
            <span>Mã Giảm Giá / Voucher</span>
        </a>

        <a class="nav-link-gt <%= (typeof pageTitle !== 'undefined' && pageTitle.includes('Ưu Đãi')) ? 'active' : '' %>" href="/partner/promotions?kind=automatic">
            <i class="fas fa-bullhorn"></i>
            <span>Chương Trình Ưu Đãi</span>
        </a>

        <div class="mt-auto pt-4 border-top">
            <div class="card-gt p-3 bg-subtle-mint mb-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fas fa-headset text-primary"></i>
                    <span class="fw-bold fs-sm">Hỗ Trợ Đối Tác</span>
                </div>
                <p class="fs-xs text-muted mb-0">Liên hệ đội ngũ GlobeTrek 24/7 khi cần hỗ trợ thanh toán hoặc tour.</p>
            </div>

            <form action="/api/auth/signout" method="POST" class="m-0">
                <button type="submit" class="btn btn-gt-ghost text-danger w-100 justify-content-start gap-2">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Đăng Xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Global Universal High-Resolution Image Lightbox Modal for Partner Portal -->
    <div class="modal fade" id="gtGlobalImageModal" tabindex="-1" aria-labelledby="gtGlobalImageModalTitle" aria-hidden="true" style="z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content shadow-2xl">
                <div class="modal-header border-0 pb-2 px-4 pt-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 bg-emerald text-white fs-xs" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-image"></i>
                        </div>
                        <div>
                            <h6 class="modal-title fw-bold text-white mb-0 fs-6" id="gtGlobalImageModalTitle">Xem Ảnh Gốc</h6>
                            <small class="text-white-50 fs-xs" id="gtGlobalImageModalMeta">Độ phân giải chất lượng cao</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <div class="lightbox-toolbar">
                            <button type="button" class="lightbox-btn" id="gtLightboxZoomOut" title="Thu nhỏ">
                                <i class="fas fa-search-minus"></i>
                            </button>
                            <button type="button" class="lightbox-btn" id="gtLightboxReset" title="Tỷ lệ 100%">
                                <i class="fas fa-expand"></i>
                            </button>
                            <button type="button" class="lightbox-btn" id="gtLightboxZoomIn" title="Phóng to">
                                <i class="fas fa-search-plus"></i>
                            </button>
                            <a href="#" target="_blank" class="lightbox-btn" id="gtLightboxOpenOriginal" title="Mở trong tab mới">
                                <i class="fas fa-arrow-up-right-from-square"></i>
                            </a>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                </div>
                <div class="modal-body p-3">
                    <div class="lightbox-img-wrapper" id="gtLightboxWrapper">
                        <img src="" alt="Full Preview" class="lightbox-img" id="gtGlobalImageModalImg">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS & Custom Navigation Script -->
    <script src="/js/csrf.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Image Lightbox Handler
        let currentZoom = 1;
        window.openImageLightbox = function(imageUrl, title, meta) {
            if (!imageUrl) return;
            const modalEl = document.getElementById('gtGlobalImageModal');
            if (!modalEl) return;
            const imgEl = document.getElementById('gtGlobalImageModalImg');
            const titleEl = document.getElementById('gtGlobalImageModalTitle');
            const metaEl = document.getElementById('gtGlobalImageModalMeta');
            const openLinkEl = document.getElementById('gtLightboxOpenOriginal');

            currentZoom = 1;
            imgEl.src = imageUrl;
            imgEl.style.transform = `scale(${currentZoom})`;
            if (title && titleEl) titleEl.textContent = title;
            if (meta && metaEl) metaEl.textContent = meta;
            if (openLinkEl) openLinkEl.href = imageUrl;

            const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
            bsModal.show();
        };

        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('partnerSidebarToggleBtn');
            const sidebar = document.getElementById('partnerSidebar');
            const backdrop = document.getElementById('partnerSidebarBackdrop');

            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                    if (backdrop) backdrop.classList.toggle('show');
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', function () {
                    sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                });
            }

            // Zoom controls
            const imgEl = document.getElementById('gtGlobalImageModalImg');
            document.getElementById('gtLightboxZoomIn')?.addEventListener('click', () => {
                if (currentZoom < 3) {
                    currentZoom += 0.25;
                    imgEl.style.transform = `scale(${currentZoom})`;
                }
            });
            document.getElementById('gtLightboxZoomOut')?.addEventListener('click', () => {
                if (currentZoom > 0.5) {
                    currentZoom -= 0.25;
                    imgEl.style.transform = `scale(${currentZoom})`;
                }
            });
            document.getElementById('gtLightboxReset')?.addEventListener('click', () => {
                currentZoom = 1;
                imgEl.style.transform = `scale(1)`;
            });
            document.getElementById('gtLightboxCopyBtn')?.addEventListener('click', () => {
                const url = document.getElementById('gtLightboxUrlDisplay')?.textContent;
                if (url) {
                    navigator.clipboard.writeText(url);
                    alert('Đã sao chép liên kết ảnh gốc!');
                }
            });

            // Delegate auto preview on all .gt-img-preview
            document.body.addEventListener('click', function(e) {
                const target = e.target.closest('.gt-img-preview');
                if (target) {
                    const imgUrl = target.getAttribute('data-gt-preview') || target.querySelector('img')?.src || target.src;
                    const title = target.getAttribute('data-gt-title') || 'Xem ảnh gốc';
                    if (imgUrl) {
                        e.preventDefault();
                        window.openImageLightbox(imgUrl, title);
                    }
                }
            });

            // Highlight current active link
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.nav-link-gt');
            navLinks.forEach(link => {
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                }
            });
        });
    </script>
</body>
</html>
