<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Loại Tour - GlobeTrek Admin</title>
    
    <!-- Favicon / Brand Logo -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="shortcut icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="apple-touch-icon" href="/images/logo.jpg">
</head>
<body>
    <%- include('../header', { pageTitle: 'Tour Types' }) %>
    
    <div class="main-content-layout">
        <!-- Page Header with Action Button -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <h2 class="fw-bold text-main mb-1">Quản Lý Phân Loại Tour</h2>
                <p class="text-muted fs-sm mb-0">Danh mục phân loại hình thức du lịch và thời gian tạo trên GlobeTrek</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-gt-primary" data-bs-toggle="modal" data-bs-target="#addTourTypeModal">
                    <i class="fas fa-plus-circle me-1"></i> Thêm Loại Tour Mới
                </button>
            </div>
        </div>

        <!-- Full Width Tour Types Table Card -->
        <%
          const currentSort = (typeof filters !== 'undefined' && filters.sortBy) ? filters.sortBy : 'createdAt';
          const currentOrder = (typeof filters !== 'undefined' && filters.order) ? filters.order : 'desc';
          const currentSearch = (typeof filters !== 'undefined' && filters.search) ? filters.search : '';

          function getSortUrl(field) {
            let nextOrder = 'desc';
            if (currentSort === field) {
              nextOrder = currentOrder === 'desc' ? 'asc' : 'desc';
            }
            const params = new URLSearchParams();
            if (currentSearch) params.set('search', currentSearch);
            params.set('sortBy', field);
            params.set('order', nextOrder);
            return '?' + params.toString();
          }

          function getSortIcon(field) {
            if (currentSort !== field) return '<i class="fas fa-sort text-muted ms-1 fs-xs"></i>';
            return currentOrder === 'asc' 
              ? '<i class="fas fa-sort-up text-primary ms-1"></i>' 
              : '<i class="fas fa-sort-down text-primary ms-1"></i>';
          }
        %>
        <div class="card-gt p-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold text-main mb-0 fs-5">Danh Sách Loại Tour</h4>
                    <span class="badge-gt badge-gt-info">
                        <i class="fas fa-tags"></i> <%= typeof totalItems !== 'undefined' ? totalItems : (tourTypes ? tourTypes.length : 0) %> Loại hình
                    </span>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Quick Sort Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-gt-outline btn-gt-sm dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-arrow-down-short-wide text-primary me-1"></i>
                            <span>
                                <% if (currentSort === 'tours' && currentOrder === 'desc') { %>Nhiều tour nhất
                                <% } else if (currentSort === 'tours' && currentOrder === 'asc') { %>Ít tour nhất
                                <% } else if (currentSort === 'createdAt' && currentOrder === 'asc') { %>Cũ nhất
                                <% } else if (currentSort === 'name' && currentOrder === 'asc') { %>Tên (A-Z)
                                <% } else if (currentSort === 'name' && currentOrder === 'desc') { %>Tên (Z-A)
                                <% } else { %>Mới nhất<% } %>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                            <li><a class="dropdown-item fs-sm py-2 <%= (currentSort === 'createdAt' && currentOrder === 'desc') ? 'active fw-bold' : '' %>" href="?sortBy=createdAt&order=desc<%= currentSearch ? '&search=' + currentSearch : '' %>"><i class="far fa-clock me-2"></i>Mới nhất (Mặc định)</a></li>
                            <li><a class="dropdown-item fs-sm py-2 <%= (currentSort === 'createdAt' && currentOrder === 'asc') ? 'active fw-bold' : '' %>" href="?sortBy=createdAt&order=asc<%= currentSearch ? '&search=' + currentSearch : '' %>"><i class="fas fa-history me-2"></i>Cũ nhất</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item fs-sm py-2 <%= (currentSort === 'tours' && currentOrder === 'desc') ? 'active fw-bold' : '' %>" href="?sortBy=tours&order=desc<%= currentSearch ? '&search=' + currentSearch : '' %>"><i class="fas fa-arrow-down-wide-short me-2"></i>Số tour: Nhiều nhất</a></li>
                            <li><a class="dropdown-item fs-sm py-2 <%= (currentSort === 'tours' && currentOrder === 'asc') ? 'active fw-bold' : '' %>" href="?sortBy=tours&order=asc<%= currentSearch ? '&search=' + currentSearch : '' %>"><i class="fas fa-arrow-up-wide-short me-2"></i>Số tour: Ít nhất</a></li>
                        </ul>
                    </div>

                    <!-- Search Input -->
                    <form action="/tourtypes" method="GET" class="m-0">
                        <input type="hidden" name="sortBy" value="<%= currentSort %>">
                        <input type="hidden" name="order" value="<%= currentOrder %>">
                        <div class="search-input-group" style="width: 240px;">
                            <i class="fas fa-search"></i>
                            <input type="text" id="typeSearchInput" name="search" class="form-control-gt py-1 fs-sm" placeholder="Tìm kiếm loại tour..." value="<%= currentSearch %>" maxlength="100">
                        </div>
                    </form>
                </div>
            </div>

            <div class="table-gt-container border-0 shadow-none">
                <div class="table-responsive">
                    <table class="table-gt" id="tourTypeTable">
                        <thead>
                            <tr>
                                <th>
                                    <a href="<%- getSortUrl('name') %>" class="text-decoration-none text-main d-inline-flex align-items-center" title="Sắp xếp theo tên">
                                        Tên Phân Loại Tour <%- getSortIcon('name') %>
                                    </a>
                                </th>
                                <th>
                                    <a href="<%- getSortUrl('tours') %>" class="text-decoration-none text-main d-inline-flex align-items-center" title="Sắp xếp theo số lượng tour">
                                        Số Lượng Tour <%- getSortIcon('tours') %>
                                    </a>
                                </th>
                                <th>Mô Tả Danh Mục</th>
                                <th>
                                    <a href="<%- getSortUrl('createdAt') %>" class="text-decoration-none text-main d-inline-flex align-items-center" title="Sắp xếp theo ngày tạo">
                                        Ngày Tạo <%- getSortIcon('createdAt') %>
                                    </a>
                                </th>
                                <th class="text-end">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!tourTypes || tourTypes.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <div class="empty-state-gt border-0 py-3">
                                            <div class="empty-state-icon">
                                                <i class="fas fa-tags"></i>
                                            </div>
                                            <h6 class="fw-bold text-main">Chưa có loại tour nào phù hợp.</h6>
                                            <p class="empty-state-desc mb-3">Nhấn nút "Thêm Loại Tour Mới" ở trên để khởi tạo danh mục đầu tiên.</p>
                                            <button type="button" class="btn btn-gt-primary btn-gt-sm" data-bs-toggle="modal" data-bs-target="#addTourTypeModal">
                                                <i class="fas fa-plus-circle me-1"></i> Thêm Loại Tour
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% tourTypes.forEach(tourType => { %>
                                    <tr class="type-item" data-name="<%= tourType.name ? tourType.name.toLowerCase() : '' %>" data-desc="<%= tourType.description ? tourType.description.toLowerCase() : '' %>">
                                        <td>
                                             <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle p-2 bg-cyan text-white fs-xs d-flex align-items-center justify-content-center" style="background: var(--secondary); width: 38px; height: 38px;">
                                                    <i class="fas fa-tags"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-main fs-6"><%= tourType.name %></div>
                                                    <% if (tourType.isFeatured) { %>
                                                        <span class="badge bg-success-subtle text-success fs-xs py-0 px-1 mt-1 rounded-pill border border-success-subtle">
                                                            <i class="fas fa-star me-1"></i> Nổi bật
                                                        </span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge-gt badge-gt-neutral">
                                                <i class="fas fa-route me-1"></i> <%= tourType.tourCount || 0 %> Tour
                                            </span>
                                        </td>
                                        <td style="max-width: 320px;">
                                            <div class="text-muted fs-sm text-truncate" title="<%= tourType.description || 'Chưa có mô tả' %>">
                                                <%= tourType.description || '—' %>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fs-sm text-muted">
                                                <i class="far fa-clock me-1"></i>
                                                <%= tourType.createdAt ? new Date(tourType.createdAt).toLocaleDateString('vi-VN') : 'Mới tạo' %>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" 
                                                    class="btn btn-gt-ghost text-primary btn-gt-sm me-1 btn-detail-type"
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#detailTourTypeModal"
                                                    data-id="<%= tourType._id %>"
                                                    data-name="<%= tourType.name %>"
                                                    data-description="<%= tourType.description || '' %>"
                                                    data-featured="<%= tourType.isFeatured ? 'true' : 'false' %>"
                                                    data-tours="<%= tourType.tourCount || 0 %>"
                                                    data-created="<%= tourType.createdAt ? new Date(tourType.createdAt).toLocaleString('vi-VN') : 'Mới tạo' %>"
                                                    title="Xem chi tiết phân loại">
                                                <i class="fas fa-eye me-1"></i> Chi tiết
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-gt-outline btn-gt-sm me-1 btn-edit-type" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editTourTypeModal"
                                                    data-id="<%= tourType._id %>"
                                                    data-name="<%= tourType.name %>"
                                                    data-description="<%= tourType.description || '' %>"
                                                    data-featured="<%= tourType.isFeatured ? 'true' : 'false' %>">
                                                <i class="fas fa-pen-to-square me-1"></i> Sửa
                                            </button>
                                            <a href="/admin/tourtypes/delete/<%= tourType._id %>" class="btn btn-gt-ghost text-danger btn-gt-sm border">
                                                <i class="fas fa-trash-can me-1"></i> Xóa
                                            </a>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 mt-4 pt-3 border-top">
                    <div class="fs-sm text-muted">
                        Hiển thị <strong><%= (currentPage - 1) * 8 + 1 %> - <%= Math.min(currentPage * 8, totalItems) %></strong> trong tổng số <strong><%= totalItems %></strong> loại tour
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %><%= typeof queryString !== 'undefined' ? queryString : '' %>" class="btn btn-gt-outline btn-gt-sm">
                                <i class="fas fa-chevron-left me-1"></i> Trước
                            </a>
                        <% } else { %>
                            <button class="btn btn-gt-outline btn-gt-sm" disabled>
                                <i class="fas fa-chevron-left me-1"></i> Trước
                            </button>
                        <% } %>

                        <div class="d-flex gap-1">
                            <% for (let p = 1; p <= totalPages; p++) { %>
                                <% if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) { %>
                                    <a href="?page=<%= p %><%= typeof queryString !== 'undefined' ? queryString : '' %>" 
                                       class="btn btn-gt-sm <%= p === currentPage ? 'btn-gt-primary' : 'btn-gt-outline' %> px-3">
                                        <%= p %>
                                    </a>
                                <% } else if (p === currentPage - 2 || p === currentPage + 2) { %>
                                    <span class="px-2 text-muted align-self-center">...</span>
                                <% } %>
                            <% } %>
                        </div>

                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %><%= typeof queryString !== 'undefined' ? queryString : '' %>" class="btn btn-gt-outline btn-gt-sm">
                                Sau <i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        <% } else { %>
                            <button class="btn btn-gt-outline btn-gt-sm" disabled>
                                Sau <i class="fas fa-chevron-right ms-1"></i>
                            </button>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Modal: Thêm Loại Tour Mới -->
    <!-- Modal: Tạo Loại Tour Mới -->
    <div class="modal fade" id="addTourTypeModal" tabindex="-1" aria-labelledby="addTourTypeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-gt-content">
                <div class="modal-header border-0 bg-subtle-mint">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-badge cyan">
                            <i class="fas fa-tags"></i>
                        </div>
                        <h5 class="modal-title fw-bold text-main" id="addTourTypeModalLabel">Tạo Phân Loại Tour Mới</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/admin/tourtypes" method="POST">
                    <div class="modal-body p-4">
                        <div class="form-group-gt mb-3">
                            <label for="modalTourTypeName" class="form-label-gt">Tên Loại Hình Tour <span class="text-danger">*</span></label>
                            <div class="search-input-group">
                                <i class="fas fa-tag"></i>
                                <input type="text" id="modalTourTypeName" name="name" class="form-control-gt" placeholder="Ví dụ: Nghỉ Dưỡng, Thám Hiểm, Biển Đảo, Văn Hóa..." maxlength="100" required autofocus>
                            </div>
                            <small class="text-muted fs-xs">Tối đa 100 ký tự</small>
                        </div>

                        <div class="form-group-gt mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="modalTourTypeDesc" class="form-label-gt mb-0">Mô Tả Tóm Tắt (Tùy chọn)</label>
                                <small class="text-muted fs-xs">Tối đa 500 ký tự</small>
                            </div>
                            <textarea class="form-control-gt" id="modalTourTypeDesc" name="description" rows="2" placeholder="Mô tả ngắn gọn về đặc trưng của loại tour này..." maxlength="500"></textarea>
                        </div>

                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="modalTourTypeFeatured" name="isFeatured">
                            <label class="form-check-label fs-sm fw-semibold text-main" for="modalTourTypeFeatured">
                                Đánh dấu phân loại nổi bật
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-gt-ghost" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-gt-primary">
                            <i class="fas fa-check-circle me-1"></i> Lưu Loại Tour
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Chỉnh Sửa Loại Tour -->
    <div class="modal fade" id="editTourTypeModal" tabindex="-1" aria-labelledby="editTourTypeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-gt-content">
                <div class="modal-header border-0 bg-subtle-mint">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-badge cyan">
                            <i class="fas fa-pen-to-square"></i>
                        </div>
                        <h5 class="modal-title fw-bold text-main" id="editTourTypeModalLabel">Chỉnh Sửa Loại Tour</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editTourTypeForm" method="POST" action="">
                    <div class="modal-body p-4">
                        <div class="form-group-gt mb-3">
                            <label for="editTourTypeName" class="form-label-gt">Tên Loại Hình Tour <span class="text-danger">*</span></label>
                            <div class="search-input-group">
                                <i class="fas fa-tag"></i>
                                <input type="text" id="editTourTypeName" name="name" class="form-control-gt" placeholder="Nhập tên loại tour..." maxlength="100" required>
                            </div>
                            <small class="text-muted fs-xs">Tối đa 100 ký tự</small>
                        </div>

                        <div class="form-group-gt mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="editTourTypeDesc" class="form-label-gt mb-0">Mô Tả Tóm Tắt (Tùy chọn)</label>
                                <small class="text-muted fs-xs">Tối đa 500 ký tự</small>
                            </div>
                            <textarea class="form-control-gt" id="editTourTypeDesc" name="description" rows="2" placeholder="Mô tả ngắn gọn về đặc trưng của loại tour này..." maxlength="500"></textarea>
                        </div>

                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="editTourTypeFeatured" name="isFeatured">
                            <label class="form-check-label fs-sm fw-semibold text-main" for="editTourTypeFeatured">
                                Đánh dấu phân loại nổi bật
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-gt-ghost" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-gt-primary">
                            <i class="fas fa-save me-1"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Xem Chi Tiết Loại Tour -->
    <div class="modal fade" id="detailTourTypeModal" tabindex="-1" aria-labelledby="detailTourTypeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content modal-gt-content">
                <div class="modal-header border-0 bg-subtle-mint">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-badge cyan">
                            <i class="fas fa-tags"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-main mb-0" id="detailTypeName">Chi Tiết Loại Tour</h5>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge bg-success-subtle text-success fs-xs py-0 px-2 rounded-pill border border-success-subtle d-none" id="detailTypeFeaturedBadge">
                                    <i class="fas fa-star me-1"></i> Nổi bật
                                </span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 bg-body">
                    <!-- Meta Information Grid -->
                    <div class="detail-section-card">
                        <div class="detail-section-title">
                            <i class="fas fa-circle-info text-primary"></i> Thông Tin Chung
                        </div>
                        <div class="row g-2">
                            <div class="col-sm-4">
                                <div class="detail-field-row">
                                    <span class="detail-field-label">Trạng Thái:</span>
                                    <span class="detail-field-value fw-semibold text-main" id="detailTypeStatusText">Phổ thông</span>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="detail-field-row">
                                    <span class="detail-field-label">Số Tour:</span>
                                    <span class="detail-field-value fw-semibold text-primary" id="detailTypeTourCount">0 Tour</span>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="detail-field-row">
                                    <span class="detail-field-label">Thời Gian Tạo:</span>
                                    <span class="detail-field-value fs-sm text-muted" id="detailTypeCreated">—</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Full Description -->
                    <div class="detail-section-card mb-0">
                        <div class="detail-section-title">
                            <i class="fas fa-align-left text-secondary"></i> Mô Tả Phân Loại Đầy Đủ
                        </div>
                        <div class="detail-text-box" id="detailTypeDesc">
                            Chưa có mô tả chi tiết cho loại tour này.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-white">
                    <button type="button" class="btn btn-gt-ghost" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-gt-primary" id="detailTypeEditBtn">
                        <i class="fas fa-pen-to-square me-1"></i> Chỉnh Sửa Loại Tour Này
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Live Search Filter (Name & Description)
        document.getElementById('typeSearchInput').addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            document.querySelectorAll('.type-item').forEach(item => {
                const name = item.getAttribute('data-name') || '';
                const desc = item.getAttribute('data-desc') || '';
                item.style.display = (!query || name.includes(query) || desc.includes(query)) ? '' : 'none';
            });
        });

        // Populate Detail Modal dynamically
        const detailTypeModal = document.getElementById('detailTourTypeModal');
        let currentDetailTypeData = null;
        if (detailTypeModal) {
            detailTypeModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;
                const id = button.getAttribute('data-id');
                const name = button.getAttribute('data-name');
                const desc = button.getAttribute('data-description') || 'Chưa có mô tả chi tiết cho loại tour này.';
                const featured = button.getAttribute('data-featured') === 'true';
                const tours = button.getAttribute('data-tours') || '0';
                const created = button.getAttribute('data-created') || 'Mới tạo';

                currentDetailTypeData = { id, name, desc, featured };

                document.getElementById('detailTypeName').textContent = name;
                const statusTextEl = document.getElementById('detailTypeStatusText');
                if (statusTextEl) statusTextEl.textContent = featured ? 'Nổi bật' : 'Phổ thông';
                const tourCountEl = document.getElementById('detailTypeTourCount');
                if (tourCountEl) tourCountEl.textContent = `${tours} Tour`;
                document.getElementById('detailTypeCreated').textContent = created;
                document.getElementById('detailTypeDesc').textContent = desc;

                const featBadge = document.getElementById('detailTypeFeaturedBadge');
                if (featBadge) {
                    if (featured) featBadge.classList.remove('d-none');
                    else featBadge.classList.add('d-none');
                }
            });

            // Quick transition to Edit Modal
            document.getElementById('detailTypeEditBtn')?.addEventListener('click', function() {
                if (!currentDetailTypeData) return;
                const bsDetailModal = bootstrap.Modal.getInstance(detailTypeModal);
                if (bsDetailModal) bsDetailModal.hide();

                setTimeout(() => {
                    const editBtn = document.querySelector(`.btn-edit-type[data-id="${currentDetailTypeData.id}"]`);
                    if (editBtn) editBtn.click();
                }, 300);
            });
        }

        // Populate Edit Modal dynamically
        const editTypeModal = document.getElementById('editTourTypeModal');
        if (editTypeModal) {
            editTypeModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;
                const id = button.getAttribute('data-id');
                const name = button.getAttribute('data-name');
                const desc = button.getAttribute('data-description') || '';
                const featured = button.getAttribute('data-featured') === 'true';
                
                const form = editTypeModal.querySelector('#editTourTypeForm');
                const nameInput = editTypeModal.querySelector('#editTourTypeName');
                const descInput = editTourTypeDesc;
                const featCheck = editTypeModal.querySelector('#editTourTypeFeatured');
                
                if (form) form.action = `/admin/tourtypes/edit/${id}`;
                if (nameInput) nameInput.value = name || '';
                if (descInput) descInput.value = desc;
                if (featCheck) featCheck.checked = featured;
                
                setTimeout(() => nameInput && nameInput.focus(), 150);
            });
        }
    </script>
</body>
</html>
